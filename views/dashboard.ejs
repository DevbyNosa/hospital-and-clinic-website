<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes, viewport-fit=cover">
<title>Admin Dashboard</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link rel="stylesheet" href="/styles/dashboard.css">
</head>
<body>
<div class="dashboard-shell">
<aside class="sidebar">
<div class="brand">
<i class="fas fa-hospital-symbol"></i>
<div>
    <strong>HealthCare</strong>
    <span>Admin Portal</span>
</div>
</div>
<nav class="sidebar-nav">
<a href="#" class="active"><i class="fas fa-tachometer-alt"></i> Overview</a>
<a href="#appointments"><i class="fas fa-calendar-check"></i> Appointments</a>
<a href="#patients"><i class="fas fa-user-injured"></i> Patients</a>
<a href="auth.html"><i class="fas fa-sign-out-alt"></i> Logout</a>
</nav>
</aside>
<div class="mobile-nav-overlay hidden"></div>

<div class="dashboard-main">
<header class="topbar">
<div class="topbar-left">
    <h1>Hospital Admin Dashboard</h1>
    <p>Manage bookings and hospital operations in one control panel.</p>
</div>
<div class="topbar-actions">
    <button class="menu-toggle icon-btn" type="button" aria-label="Open navigation menu">
        <i class="fas fa-bars"></i>
    </button>
    <button class="icon-btn notification-btn" type="button">
        <i class="fas fa-bell"></i>
        <span id="notification-badge" class="notification-badge"></span>
    </button>
    <button class="icon-btn"><i class="fas fa-envelope"></i></button>
    <div class="profile-pill">
        <span>AD</span>
        <div>
            <strong>Admin</strong>
            <span>Hospital Manager</span>
        </div>
    </div>
</div>
</header>

<section class="overview-cards">
<article class="metric-card">
    <div class="card-icon accent-blue"><i class="fas fa-calendar-check"></i></div>
    <div>
        <h3>18</h3>
        <p>Pending bookings</p>
    </div>
</article>
<article class="metric-card">
    <div class="card-icon accent-green"><i class="fas fa-user-injured"></i></div>
    <div>
        <h3>72</h3>
        <p>Active patients</p>
    </div>
</article>
</section>

<section class="dashboard-grid">
<div class="panel card" id="appointments">
    <div class="panel-header">
        <h2>Booking Queue</h2>
        <a href="#" class="text-link">View all</a>
    </div>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Service</th>
                    <th>Preferred Date</th>
                    <th>Preferred Time</th>
                    <th>Message</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="booking-list">
                <tr>
                    <td colspan="9" class="empty-row">Loading bookings from the database...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="side-grid">
    <div class="panel card">
        <div class="panel-header">
            <h2>Maintenance Mode</h2>
            <span class="status-chip maintenance-off">Offline</span>
        </div>
        <div class="maintenance-panel">
            <p>Turn maintenance mode on to pause new bookings while system updates or internal checks are in progress.</p>
            <label for="maintenance-route">Maintenance route (optional)</label>
            <input id="maintenance-route" type="text" placeholder="/maintenance" />
            <small id="maintenance-note">Leave blank to simply pause new bookings.</small>
            <button id="maintenance-toggle" class="btn btn-secondary">Enable maintenance</button>
        </div>
    </div>
    <div class="panel card">
        <div class="panel-header">
            <h2>Admin Actions</h2>
        </div>
        <div class="quick-actions">
            <button class="action-btn"><i class="fas fa-calendar-plus"></i> Confirm booking</button>
            <button class="action-btn"><i class="fas fa-user-check"></i> Check in patient</button>
            <button class="action-btn"><i class="fas fa-notes-medical"></i> Update appointment</button>
        </div>
    </div>
</div>
</section>
</div>
</div>
<div id="booking-modal" class="modal hidden">
    <div class="modal-backdrop"></div>
    <section class="modal-panel">
        <button id="close-booking-modal" class="modal-close" type="button">×</button>
        <h2>Booking Details</h2>
        <div class="modal-body">
            <p><strong>Name:</strong> <span id="modal-name"></span></p>
            <p><strong>Email:</strong> <span id="modal-email"></span></p>
            <p><strong>Phone:</strong> <span id="modal-phone"></span></p>
            <p><strong>Service:</strong> <span id="modal-service"></span></p>
            <p><strong>Date:</strong> <span id="modal-date"></span></p>
            <p><strong>Time:</strong> <span id="modal-time"></span></p>
            <p><strong>Message:</strong></p>
            <p id="modal-message" class="modal-message"></p>
        </div>
    </section>
</div>
<script src="/js/dashboard.js"></script>
</body>
</html>
