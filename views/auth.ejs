<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/styles/auth.css">
</head>
<body>
    <div class="auth-shell">
        <header class="auth-header">
            <a href="index.html" class="logo"><i class="fas fa-clinic-medical"></i> HealthCare Clinic</a>
        </header>

        <main class="auth-main">
            <section class="auth-preview">
                <span class="section-tag">Admin Portal</span>
                <h1>Hospital admin login</h1>
                <p>Access appointment management, billing oversight, and hospital operations from one secure dashboard.</p>
            </section>

    <section class="auth-box">
        <div class="auth-card active" id="login-card">
            <h2>Admin Sign In</h2>
            <p>Enter your administrator credentials to manage hospital bookings and payments.</p>
            <form id="login-form" action="/admin/login" method="POST">
                <div class="form-group">
                    <label for="login-email">Email</label>
                    <input type="text" id="login-email" name="admin_email" placeholder="admin@hospital.com" required>
                </div>
                <div class="form-group">
                    <label for="login-password">Password</label>
                    <input type="password" id="login-password" placeholder="Enter your password" name="admin_password" required>
                </div>
                <div class="form-helper-row">
                    <label class="checkbox-label">
                        <input type="checkbox" name="remember"> Remember me
                    </label>
                    <a href="#" class="text-link">Forgot password?</a>
                </div>
                <button type="submit" class="btn btn-primary">Login as Admin</button>
            </form>
        </div>

        <div><%= locals.errorMessage %></div>
    </section>
</main>
    </div>

    <script src="/js/auth.js"></script>
</body>
</html>
